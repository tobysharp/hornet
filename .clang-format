BasedOnStyle: Google
IndentWidth: 2
ColumnLimit: 120
AllowShortFunctionsOnASingleLine: All
AlwaysBreakTemplateDeclarations: No
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
SpacesBeforeTrailingComments: 2
SortIncludes: true
IncludeBlocks: Preserve
IncludeCategories:
  - Regex:           '^<>'
    Priority:        1
  - Regex:           '^"[^/]+\.h"$'
    Priority:        2

