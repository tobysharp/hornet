{
    "configurations": [
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/clang++-20",
            "compileCommands": "${workspaceFolder}/build/clang20-debug/compile_commands.json",
            "compilerArgs": [
                "-stdlib=libc++",
                "-nostdinc++",
                "-isystem",
                "/usr/lib/llvm-20/include/c++/v1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-clang-x64",
            "includePath": [
                "${default}",
                "${workspaceFolder}"
            ]
        }
    ],
    "version": 4
}